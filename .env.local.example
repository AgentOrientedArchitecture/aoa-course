# Local inference through oMLX on the Mac, alongside Docker Desktop.
# Copy to .env after preserving any existing provider configuration.
# All session launchers read .env; this example is not loaded automatically.
# Requires oMLX 0.7.3+ with both models downloaded and visible in /v1/models.
# Replace model IDs and port if your oMLX installation uses different values.

# Generation: Qwen3.8 Next. EVE uses these same generation settings.
PROVIDER=openai
MODEL=Qwen3.8-Flash-Next-oQ3.5e-mtp
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=

# Decisions: LiquidAI d1, using the native System One API and probabilities.
# Use the server root here; the course adds /v1/systemone.
DECISION_PROVIDER=systemone
DECISION_MODEL=d1-2B-MLX-8bit
DECISION_BASE_URL=http://host.docker.internal:8000
DECISION_API_KEY=
DECISION_MIN_PROBABILITY=0.65
DECISION_ALLOW_UNSCORED=false
DECISION_TIMEOUT_SECONDS=120

# If oMLX requires authentication, put its local key in BOTH key fields above.
# For an unauthenticated server only: LLM_API_KEY=local-no-auth and leave
# DECISION_API_KEY empty. Do not reuse Cerebras, TypeSafe or other hosted keys.
# Keep populated .env files private; never put a real key in this example.

PLANNER_STRATEGY=hybrid
MODEL_TIMEOUT_SECONDS=300
PLANNER_MODEL_TIMEOUT_SECONDS=180
OPENAI_REASONING_EFFORT=low
OPENAI_RESPONSE_FORMAT=json_object

# oMLX must be reachable from Docker at host.docker.internal:8000.
# A successful API call does not establish output quality or a full-course pass.
# The 0.65 decision gate is a teaching policy, not calibrated model accuracy.
