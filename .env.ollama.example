# Ollama cloud: GPT-OSS 120B for generation and Clef 27B for decisions.
# Copy this file to .env. All session launchers read .env.
# Put the same Ollama API key in LLM_API_KEY and DECISION_API_KEY below.
# Keep API keys private. Never commit a populated .env.
# No local Ollama installation or model download is required.
# Hosted Clef requires a paid plan or usage credits.
# Cloud settings checked 26 October 2026:
# https://docs.ollama.com/cloud
# https://docs.ollama.com/capabilities/decision

# Generation API. PROVIDER selects the API format, not the hosting company.
# EVE uses these generation settings too.
PROVIDER=openai
MODEL=gpt-oss:120b
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=

# Decision API. Use the server root; the client adds /v1/systemone.
# "clef" is the documented direct-cloud name for Clef 27B.
# Clef Flash is currently listed for local use, not hosted cloud use.
DECISION_PROVIDER=systemone
DECISION_MODEL=clef
DECISION_BASE_URL=https://ollama.com
DECISION_API_KEY=
DECISION_MIN_PROBABILITY=0.65
DECISION_ALLOW_UNSCORED=false
DECISION_TIMEOUT_SECONDS=120

# Shared settings.
PLANNER_STRATEGY=hybrid
MODEL_TIMEOUT_SECONDS=240
PLANNER_MODEL_TIMEOUT_SECONDS=120
OPENAI_REASONING_EFFORT=low
OPENAI_RESPONSE_FORMAT=json_object
