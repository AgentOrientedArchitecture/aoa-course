# Copy to .env.revised; add keys privately. Never commit this populated file.
PROVIDER=openai
MODEL=gpt-oss-120b
OPENAI_BASE_URL=https://api.cerebras.ai/v1
# Put CEREBRAS_API_KEY and TYPESAFE_API_KEY in .env (or add them here privately).
DECISION_PROVIDER=typesafe
DECISION_MODEL=jev-1.13.0
DECISION_BASE_URL=https://api.typesafe.ai
DECISION_MIN_PROBABILITY=0.65
DECISION_ALLOW_UNSCORED=false
DECISION_TIMEOUT_SECONDS=120
PLANNER_STRATEGY=hybrid
MODEL_TIMEOUT_SECONDS=240
PLANNER_MODEL_TIMEOUT_SECONDS=120
OPENAI_REASONING_EFFORT=low
OPENAI_RESPONSE_FORMAT=json_object
