# Copy this file to `.env` and add your API key before starting the stack:
#   cp .env.ollama-cloud .env
# Never put a real key in this preset file itself — it is tracked by git.
#
# ollama.com's hosted service ("Ollama cloud") serves an OpenAI-compatible
# API, so the course talks to it through PROVIDER=openai. (The native
# PROVIDER=ollama path is for a local Ollama server only — it does not send
# the Authorization header the cloud API requires.)

# ----------------------------------------------------------------------
# Model provider
# ----------------------------------------------------------------------
PROVIDER=openai

# The model name as ollama.com knows it. Cloud-hosted examples:
#   gpt-oss:120b, gpt-oss:20b, deepseek-v3.1:671b, qwen3-coder:480b
MODEL=gpt-oss:120b

# ----------------------------------------------------------------------
# Provider credentials
# ----------------------------------------------------------------------
# Create a key at https://ollama.com/settings/keys and paste it here.
#
# Course key used inside containers. This avoids accidentally inheriting a
# global OPENAI_API_KEY from your shell when using an OpenAI-compatible provider.
AOA_OPENAI_API_KEY=

# Optional for direct local tests outside Docker. Compose does not use this
# value for containers; set AOA_OPENAI_API_KEY for the course stack.
OPENAI_API_KEY=

# ollama.com's OpenAI-compatible API root.
OPENAI_BASE_URL=https://ollama.com/v1

ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------
# Local model server (unused with the cloud API)
# ----------------------------------------------------------------------
# Only read when PROVIDER=ollama; kept here so switching back to a local
# Ollama is a two-line change (PROVIDER and MODEL).
OLLAMA_HOST=http://host.docker.internal:11434

# ----------------------------------------------------------------------
# Timeouts
# ----------------------------------------------------------------------
# Smaller local models can be slower, especially when parsing PDFs.
MODEL_TIMEOUT_SECONDS=240
MODEL_MAX_TOKENS=8192
OPENAI_REASONING_EFFORT=low
OPENAI_RESPONSE_FORMAT=json_object
OLLAMA_RESPONSE_FORMAT=json
OLLAMA_THINK=false
PLANNER_INVOKE_TIMEOUT=300
PLANNER_REQUEST_TIMEOUT=420
PLANNER_STRATEGY=hybrid
PLANNER_MODEL_TIMEOUT_SECONDS=60
PLANNER_MODEL_MAX_TOKENS=2048

# ----------------------------------------------------------------------
# Registry governance demo actors
# ----------------------------------------------------------------------
# These are seeded actor identities for the course registry lifecycle surface.
# They make publish/approve/review ownership visible without adding a full
# workflow engine.
REGISTRY_PUBLISHER_AGENT_ID=urn:aoa:role:platform-team-publisher
REGISTRY_APPROVER_AGENT_ID=urn:aoa:role:risk-curator-approver
REGISTRY_REVIEWER_AGENT_ID=urn:aoa:role:registry-reviewer
REGISTRY_DEFAULT_LIFECYCLE_STATUS=approved
