# Local teaching baseline: generation and constrained choice through Ollama.
# This is not Jev and supplies no calibrated option probabilities.
PROVIDER=ollama
MODEL=gpt-oss:20b
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_THINK=false
OLLAMA_RESPONSE_FORMAT=json
DECISION_PROVIDER=ollama
DECISION_MODEL=gpt-oss:20b
DECISION_BASE_URL=http://host.docker.internal:11434
DECISION_ALLOW_UNSCORED=true
DECISION_TIMEOUT_SECONDS=240
PLANNER_STRATEGY=hybrid
MODEL_TIMEOUT_SECONDS=300
PLANNER_MODEL_TIMEOUT_SECONDS=180
# Use gpt-oss:120b for the generation lesson where local hardware permits.
