# Copy this file to .env. All session launchers use it; no course-mode flag needed.
# Keep API keys private. Never commit a populated .env.

# Generation API. These example values use Cerebras; the names are provider-neutral.
# PROVIDER selects the API format. Change the URL, MODEL and key together.
PROVIDER=openai
MODEL=gpt-oss-120b
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_API_KEY=

# Decision API. These example values use TypeSafe's Jev model.
DECISION_PROVIDER=typesafe
DECISION_MODEL=jev-1.13.0
DECISION_BASE_URL=https://api.typesafe.ai
DECISION_API_KEY=
DECISION_MIN_PROBABILITY=0.65
DECISION_ALLOW_UNSCORED=false
DECISION_TIMEOUT_SECONDS=120

# Shared settings.
PLANNER_STRATEGY=hybrid
MODEL_TIMEOUT_SECONDS=240
PLANNER_MODEL_TIMEOUT_SECONDS=120
OPENAI_REASONING_EFFORT=low
OPENAI_RESPONSE_FORMAT=json_object
OLLAMA_RESPONSE_FORMAT=json
OLLAMA_THINK=false
OLLAMA_HOST=http://host.docker.internal:11434

# LOCAL OPTION: change the settings above to these values in this same file.
# Install Ollama on the host and pull the named model first.
# PROVIDER=ollama
# MODEL=gpt-oss:20b
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=
# DECISION_PROVIDER=ollama
# DECISION_MODEL=gpt-oss:20b
# DECISION_BASE_URL=http://host.docker.internal:11434
# DECISION_API_KEY=
# DECISION_ALLOW_UNSCORED=true
# DECISION_TIMEOUT_SECONDS=240
# MODEL_TIMEOUT_SECONDS=300
# PLANNER_MODEL_TIMEOUT_SECONDS=180
# EVE uses Ollama's OpenAI-compatible endpoint from LLM_BASE_URL.
# Use gpt-oss:120b for generation where local hardware permits.

# NATIVE LOCAL DECISIONS: Clef uses System One, not the Ollama chat fallback.
# With Ollama 0.35.1+ and clef-flash downloaded, change the existing values:
# DECISION_PROVIDER=systemone
# DECISION_MODEL=clef-flash
# DECISION_BASE_URL=http://host.docker.internal:11434
# DECISION_API_KEY=
# DECISION_ALLOW_UNSCORED=false
# oMLX 0.7.2+ can serve an MLX Clef checkpoint through the same protocol.
# Use its server root and exact /v1/models ID. Clear DECISION_API_KEY for an
# unauthenticated local server, or use that server's own key.

# OTHER GENERATION APIS: keep PROVIDER=openai and set LLM_API_KEY, MODEL and:
# NVIDIA:       LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# OpenRouter:   LLM_BASE_URL=https://openrouter.ai/api/v1
# Ollama cloud: LLM_BASE_URL=https://ollama.com/v1
# Use each provider's exact model ID; see course/pre-work/SETUP.md.
# Native Anthropic uses PROVIDER=anthropic and the same LLM_API_KEY/LLM_BASE_URL
# for the Python AUs. EVE requires an OpenAI-compatible generation endpoint.
